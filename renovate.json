{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "baseBranchPatterns": [
    "main"
  ],
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    ":pinDevDependencies"
  ],
  "platformAutomerge": true,
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "pinDigest"
      ],
      "automerge": true
    },
    {
      "automerge": true,
      "automergeStrategy": "squash",
      "groupName": "github actions",
      "matchManagers": [
        "github-actions"
      ]
    },
    {
      "automerge": true,
      "automergeStrategy": "squash",
      "groupName": "dockerfile dependencies",
      "matchManagers": [
        "dockerfile"
      ]
    },
    {
      "automerge": true,
      "automergeStrategy": "squash",
      "groupName": "semantic-release",
      "matchManagers": [
        "custom.regex"
      ]
    }
  ],
  "pre-commit": {
    "enabled": true
  },
  "minimumReleaseAge": "3 days",
  "rebaseWhen": "conflicted"
}
